# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (never sync these!)
venv/
env/
ENV/
.venv/
venv_*/
*_venv/

# Environment variables
.env
.env.local

# Secrets (CRITICAL - never commit API keys!)
config/credentials/
config/credentials/secrets.ini
secrets.ini
*.pem
*.key
*_key
*_secret

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
*.ipynb

# Model checkpoints (large files)
inference/models/*/
filters/**/model/
# probe pkls (e5-small, ~0.5MB) ARE committed — needed for hybrid inference + reproducibility.
# (removed blanket filters/**/probe/ ignore 2026-07-10). Large probe variants: ignore explicitly.
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.pkl
# ...except filter hybrid-inference probes (small, needed, reproducible).
# NOTE: the comment must live on its own line — gitignore treats a trailing
# " # comment" as part of the pattern, which silently disabled this negation
# for months (probes were only tracked via per-directory .gitignore fixes).
!filters/*/v*/probe/*.pkl
# But track model metadata
!filters/**/training_*.json

# Datasets and data (large files - track metadata only)
datasets/*
datasets/*.jsonl
datasets/raw/
datasets/processed/
datasets/splits/
datasets/test/
data/

# Track metadata files for documentation
!datasets/*_metadata.json
!datasets/*/.*_metadata.json
!datasets/README.md

# Keep .gitkeep files for empty directories
!datasets/.gitkeep
!datasets/splits/.gitkeep
!inference/models/.gitkeep

# Calibration outputs (generated files)
calibrations/*/
reports/*.md
reports/*.json
reports/*.html
reports/*.docx
reports/*.pdf
reports/*/
!reports/README.md

# Experiment logs
experiments/*/
wandb/
logs/
*.log
*.log.*
calibration_run.log

# PyTorch/ML artifacts
*.pt
*.pth
*.onnx

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
test_batch_labeler.py
!tests/test_*.py

# Documentation builds
docs/_build/
site/

# Temporary files
archive/
tmp/
temp/
*.tmp
cache/
nul


# Node.js
node_modules/
package-lock.json
package.json

# Research artifacts
research/**/models/
research/**/embeddings/

# Sandbox/Experimental - NOT committed (safe space for prototyping)
# General experimentation, prototypes
sandbox/
# Python working directory (temp files)
python/
# Quick tests, temporary work
scratch/
# Testing new ideas, playing with code
playground/
# Local experiments (experiments/ root is tracked)
experiments/local/
# Messy exploratory Jupyter notebooks
notebooks/exploratory/
*.bak
*.old
*_backup.*
*_test.*

# ==============================================================================
# FreeFileSync - Large files handled by file sync, not git
# ==============================================================================
# These files are synced via FreeFileSync between local and GPU machine
# They should NOT be in git due to size

# Binary reports (keep locally, not in git)
*.docx

# Large model files (sync via FreeFileSync)
*.safetensors
*.gguf
*.h5
*.keras

# Tokenizer files (download from HuggingFace, don't track in git)
**/model/tokenizer.json
**/model/vocab.json
**/model/merges.txt

# Large datasets
*.parquet
*.feather
*.arrow

# Checkpoints and training outputs
checkpoints/
training_outputs/
model_outputs/

# FreeFileSync backup and database files
.sync-backups/
*.ffs_db
*.ffs_lock

# Deployment artifacts
model_backup/
**/model_backup/
README_MODEL.md

# Claude Code temp files
tmpclaude-*
*-cwd

# Reference PDFs: track the README pointer, keep binaries local
docs/references/*.pdf
filters/common/violence_promotion/training/*.jsonl

# Adverse examples are hand-curated evidence and ARE committed (datasets/adverse/README.md).
# Without these negations a new case is silently ignored by the datasets/ rule above.
!datasets/adverse/
!datasets/adverse/*.jsonl
# Candidates are UNADJUDICATED and must stay OUT of the datasets/adverse/*.jsonl
# glob that a future adverse-gate will read (docs/TODO.md, #91). Own subdir, own
# negation, so a glob cannot mistake a candidate for curated evidence.
!datasets/adverse/candidates/
!datasets/adverse/candidates/*.jsonl
!datasets/adverse/candidates/*.md

# Cross-box parity dumps ARE committed: they are the evidence behind a claim
# that a given box may or may not be used to measure at a given op-point
# (scripts/verification/box_parity.py). Small (~190 KB per 660-row split) and
# expensive to regenerate — ~30 min of CPU on the serving box, which can only be
# done between pipeline cycles. Without a negation the datasets/* rule above
# silently swallows them.
!datasets/parity/
!datasets/parity/*.jsonl
!datasets/parity/*.md

# Claude Code user-local settings — machine-specific permission list, never shared.
# Untracked 2026-08-06 (context audit): it had been committed and carried a
# different machine and user (C:/local_dev/..., C:/Users/scbry/...). The tracked
# .claude/skills/ reference installs stay tracked; only this file is local.
.claude/settings.local.json

# Evidence logs are the record behind a measured claim -- `*.log` above would drop
# them silently, and a docs/evidence/ page that references logs nobody else has is
# worse than no page. Negate for evidence only (2026-08-22).
!docs/evidence/**/*.log

# bash run sentinels written by background evidence runs — not evidence
docs/evidence/**/runs/*.status
