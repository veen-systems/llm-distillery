#!/bin/bash
# commit-msg hook: block "deploy"-class claims unless verified.
#
# Rationale (llm-distillery#44, 2026-04-19): a commit message saying "Deployed
# to HuggingFace Hub" does not make the upload happen. Prior to this hook, a
# session could write the claim based on intent, the upload never ran, and
# production served stale weights for days.
#
# Gate: if the commit message contains deploy-class words AND the staged diff
# touches any filters/*/v*/ directory, re-run verify_filter_package.py with
# --check-hub against each affected filter. Block the commit if verification
# fails for any of them.
#
# Escape hatch: re-run with `git commit --no-verify` if you really know what
# you're doing. The hook is a floor, not a replacement for the
# claim-requires-verify discipline. Do not make --no-verify a habit.
#
# Install: this file is checked in at .githooks/commit-msg. Enable for the
# repo with `git config core.hooksPath .githooks` (one-time per clone).

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Strip comment lines that git adds to the template — users never mean those.
STRIPPED=$(echo "$COMMIT_MSG" | grep -vE '^\s*#' || true)

# Case-insensitive match against deploy-class words. Word boundaries to avoid
# matching "redeployable" etc., though false positives here just trigger verify
# which is cheap for already-good packages.
DEPLOY_WORDS='deploy|deploys|deployed|deploying|redeploy|redeployed|redeploying|ship|ships|shipped|shipping|upload|uploads|uploaded|uploading|live in production|released'
if ! echo "$STRIPPED" | grep -iqE "\\b($DEPLOY_WORDS)\\b"; then
    exit 0
fi

# Resolve the interpreter rather than assuming `python` is on PATH. On a stock
# Debian/Ubuntu box only `python3` exists, so a bare `python` made every
# verification fail with "command not found" — fail-closed, but for the wrong
# reason: the gate could never actually pass, which trains --no-verify as a
# habit and hands back the silent-stale-deploy hole this hook exists to close.
PYTHON_BIN=""
for candidate in python3 python; do
    if command -v "$candidate" > /dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done

# Negation (#136). Every session commit here says "Nothing deployed" or
# "deploy N/A", and the word test above cannot tell that from a claim. It
# blocked those commits, and its own advice was --no-verify, the override
# behind #44. The message passes only if EVERY deploy-class word sits in one of
# three phrases that OPEN a clause, the ones this repo's commits actually use
# (read off `git log`, 2026-09-29):
#   "nothing [was|is|has been] <word>"
#   "not [yet|been|re-]<word>"
#   "<word>[:] n/a"
# and only the end of the clause may follow. A clause opens at the start of the
# message, a newline, .;:,!?[ an em/en dash or "--"; it closes at the end, a
# newline, .;:,!()[] a dash or "--". Anything else is a claim: "No regressions
# deployed v7", "Errors during deploy: none" and "Rumour that v7 was not
# uploaded: debunked" are reports, not denials (PR #167 review, rounds 1-2).
# FAILS CLOSED: only the literal output "negated" lets the message through. No
# interpreter, a crash, no deploy word Python can see, or any other output
# means "claim", and the verifier runs.
NEGATION_PY=$(cat <<'PY'
import re, sys
words = sys.argv[1]
text = sys.stdin.buffer.read().decode("utf-8", "replace").lower()
END = r"\s*(?:$|--|[\n.;:,!()\[\]\u2014\u2013])"
START = r"(?:^|--|[\n.;:,!?\[\u2014\u2013])\s*"
NOTHING = re.compile(START + r"nothing\s+(?:(?:was|is|has\s+been)\s+)?$")
NOT = re.compile(START + r"not\s+(?:yet\s+|been\s+|re-)?$")
AFTER = re.compile(r"\s*:?\s*n/a" + END)
matches = list(re.finditer(r"\b(?:%s)\b" % words, text))
claim = not matches
for m in matches:
    pre, post = text[:m.start()], text[m.end():]
    before = (NOTHING.search(pre) or NOT.search(pre)) and re.match(END, post)
    after = re.search(START + "$", pre) and AFTER.match(post)
    if not (before or after):
        claim = True
print("claim" if claim else "negated")
PY
)
VERDICT=""
if [ -n "$PYTHON_BIN" ]; then
    VERDICT=$(printf '%s' "$STRIPPED" | "$PYTHON_BIN" -c "$NEGATION_PY" "$DEPLOY_WORDS" 2>/dev/null || true)
fi
if [ "$VERDICT" = "negated" ]; then
    echo "commit-msg: deploy-class word(s) appear only negated (e.g. \"nothing deployed\") — no claim, letting through."
    exit 0
fi

# Find staged filter version directories. Each touched file's filters/{name}/v{N}/
# parent is collected, unique.
STAGED_FILTER_DIRS=$(git diff --cached --name-only \
    | awk -F/ '$1=="filters" && $3 ~ /^v[0-9]+$/ {print $1"/"$2"/"$3}' \
    | sort -u)

if [ -z "$STAGED_FILTER_DIRS" ]; then
    # Deploy-class word but no filter change staged. Could be a doc/script
    # commit — let it through, but remind.
    echo "commit-msg: deploy-class word detected but no filters/*/v*/ changes staged — letting through."
    echo "  (Hook only blocks when filter packages are being modified.)"
    exit 0
fi

echo "commit-msg: deploy-class word detected in message; verifying staged filters..."

# Prefer repo-root-relative invocation for the verify script so running hooks
# from subdirectories still resolves.
REPO_ROOT=$(git rev-parse --show-toplevel)
VERIFY="$REPO_ROOT/scripts/deployment/verify_filter_package.py"

if [ ! -f "$VERIFY" ]; then
    echo "commit-msg: ERROR — $VERIFY not found. Cannot verify. Install the script or use --no-verify (discouraged)."
    exit 1
fi

if [ -z "$PYTHON_BIN" ]; then
    echo "commit-msg: ERROR — no python3/python interpreter on PATH. Cannot verify."
    exit 1
fi

# --check-hub needs credentials to see PRIVATE repos. The Hub deliberately
# returns 404 (not 403) for a repo the caller cannot see, so with no token the
# verifier reports "repo not found" for a repo that exists — a FALSE failure.
# That is dangerous specifically here: this hook's own advice on failure is
# `--no-verify`, and a prior override is what caused #44. A guard that cries
# wolf trains the override it exists to prevent. Observed 2026-08-08 on
# cultural_discovery v6 (private repo, freshly uploaded, verified 9/9 by hand).
# Falls back to the repo's own credentials file; never echoes the value.
if [ -z "${HF_TOKEN:-}" ] && [ -f "$REPO_ROOT/config/credentials/secrets.ini" ]; then
    HF_TOKEN=$("$PYTHON_BIN" - "$REPO_ROOT/config/credentials/secrets.ini" <<'PY' 2>/dev/null
import configparser, sys
c = configparser.ConfigParser()
try:
    c.read(sys.argv[1])
    print(c.get("api_keys", "huggingface_token", fallback="").strip())
except Exception:
    print("")
PY
    )
    export HF_TOKEN
    if [ -n "$HF_TOKEN" ]; then
        echo "commit-msg: HF_TOKEN taken from config/credentials/secrets.ini for --check-hub"
    fi
fi

FAILED=0
# Per-invocation temp file so parallel commits don't clobber each other.
LOG_FILE=$(mktemp -t commit-msg-verify.XXXXXX 2>/dev/null || echo "/tmp/commit-msg-verify-$$.log")
trap 'rm -f "$LOG_FILE"' EXIT
while IFS= read -r d; do
    [ -z "$d" ] && continue
    echo "  verifying $d ..."
    if ! (cd "$REPO_ROOT" && PYTHONPATH=. "$PYTHON_BIN" "$VERIFY" --filter "$d" --check-hub > "$LOG_FILE" 2>&1); then
        echo "  [FAIL] $d"
        sed 's/^/    /' "$LOG_FILE"
        FAILED=$((FAILED + 1))
    fi
done <<< "$STAGED_FILTER_DIRS"

if [ "$FAILED" -gt 0 ]; then
    cat <<EOF

commit-msg: ABORTING — $FAILED filter(s) failed verification while the commit message claims deploy/shipped/uploaded.

Either:
  1. Run the actual upload (scripts/deployment/upload_to_huggingface.py) and the
     NexusMind deploy path, THEN commit once both verifications pass.
  2. Soften the commit message (e.g. "Prepare v_N for deploy" / "Update filter
     files pending Hub upload").
  3. Override with \`git commit --no-verify\` if you are absolutely certain the
     hook is wrong. Note that a prior override caused issue #44 — three days
     of production scoring wrong weights — so the bar should be very high.

EOF
    exit 1
fi

echo "commit-msg: all staged filters verified; commit allowed."
exit 0
