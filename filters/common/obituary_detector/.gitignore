# Corpora and worksheets contain raw article content — keep on disk, never commit
validation/artifacts/*corpus*.jsonl
validation/artifacts/seed*.jsonl
validation/artifacts/worksheet*.jsonl
validation/artifacts/*candidates*.jsonl
# FN-delta / FP worksheets (LD#83 owner gate) — content-bearing like worksheets
validation/artifacts/fn_delta_*.jsonl
validation/artifacts/fp5_*.jsonl
# scripts also write a worksheet + corpus copies to the validation/ root — content-bearing
validation/worksheet*.jsonl
validation/*corpus*.jsonl
training/data/
# stray validation-root panel outputs (committed provenance lives in artifacts/*_v3.*)
validation/grades_panel_obit.jsonl
validation/rollup_obit.json
# Model binaries live on gpu-server (v1 broken, v2 proof); regenerate via training/
**/models/*
# ADR-024 (2026-09-27, owner): llm-distillery's v5 training_config.json is canonical and ships in the MANIFEST
!v5/models/training_config.json
v1/
v2/
*.pkl
